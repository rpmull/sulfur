<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Phosphorus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/desk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Phosphorus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/desk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Phosphorus</item>
    </style>
</resources>
