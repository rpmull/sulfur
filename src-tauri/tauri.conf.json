{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sulfur",
  "version": "1.0.0",
  "identifier": "dev.phosphorus.sulfur",
  "build": {
    "beforeDevCommand": "bun run build:web",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "http://127.0.0.1:47615/sulfur/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "icon": [
      "../packaging/sulfur/icons/icon.png",
      "../packaging/sulfur/icons/icon.icns",
      "../packaging/sulfur/icons/icon.ico"
    ],
    "shortDescription": "A mesh-capable code editor",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh",
        "installerIcon": "../packaging/sulfur/icons/icon.ico"
      }
    },
    "publisher": "Phosphorus",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
